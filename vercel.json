{
  "version": 2,
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "mkdir -p public/static && cp -r web/static/templates/* public/ && cp -r web/static/css public/static/ && cp -r web/static/spec public/static/",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    {
      "source": "/scrape",
      "destination": "http://124.222.208.237:8080/scrape"
    },
    {
      "source": "/jobs",
      "destination": "http://124.222.208.237:8080/jobs"
    },
    {
      "source": "/view",
      "destination": "http://124.222.208.237:8080/view"
    },
    {
      "source": "/delete",
      "destination": "http://124.222.208.237:8080/delete"
    },
    {
      "source": "/download",
      "destination": "http://124.222.208.237:8080/download"
    },
    {
      "source": "/stats",
      "destination": "http://124.222.208.237:8080/stats"
    },
    {
      "source": "/progress",
      "destination": "http://124.222.208.237:8080/progress"
    },
    {
      "source": "/api/:path*",
      "destination": "http://124.222.208.237:8080/api/:path*"
    },
    {
      "source": "/csv/:path*",
      "destination": "http://124.222.208.237:8080/csv/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "http://124.222.208.237:8080/static/:path*"
    }
  ]
}
